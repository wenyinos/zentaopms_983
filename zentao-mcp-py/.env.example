# 禅道站点地址（本地联调 / 生产域名，生产需 HTTPS）
ZENTAO_URL=http://dev.wenyinos.test:8080
# 与禅道 module/mcp/.env 中 MCP_SECRET 保持一致（HMAC 签名密钥）
MCP_SECRET=change-me
# 默认 git 仓库路径（sync_commits / get_git_commits 的 repoPath 缺省值）
MCP_REPO_PATH=/path/to/repo
# 本机禅道账号（写操作署名；须是禅道中已存在的账号）
MCP_ACCOUNT=your-account
# 本机 git 作者 -> 禅道账号映射（email 优先、其次姓名，忽略大小写；逗号分隔）
GIT_AUTHOR_MAP=you@example.com:your-account,Your Name:your-account
