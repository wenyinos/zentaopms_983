# wenyinos 统一认证 · 禅道扩展环境配置模板
# 复制为 .env（同目录）并填写实际值；.env 已被 gitignore，不会进入仓库（代码全量开源）

# 总开关：true 启用 / false 停用（停用即恢复禅道原生登录/退出）
WY_SSO_ENABLED=true

# 中心 API 入口（生产：https://wenyinos.com/auth/api.php；本机联调可用回环地址）
WY_SSO_API_URL=https://wenyinos.com/auth/api.php

# 应用凭据（由认证中心管理后台「应用密钥」页签发；secret 务必保密）
WY_SSO_APP_ID=dev
WY_SSO_SECRET=change-me-64-hex

# API 超时（秒），超时视为中心不可达并降级本地验证
WY_SSO_TIMEOUT=3

# 登录 / 退出跳转目标
WY_SSO_LOGIN_URL=https://wenyinos.com/auth/login.php
WY_SSO_LOGOUT_URL=https://wenyinos.com/auth/logout.php
